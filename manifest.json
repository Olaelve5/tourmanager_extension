{
  "manifest_version": 3,
  "name": "Tour Manager Enhancement",
  "version": "1.0",
  "description": "Legger til en kolonne som viser antall bytter for hver manager på tourmanager.no.",
  "host_permissions": [
    "https://tourmanager.no/*",
    "https://tourmanager-game.api.scoutgg.net/*"
  ],
  "icons": {
    "16": "icons/icon_16.png",
    "48": "icons/icon_48.png",
    "128": "icons/icon_128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://tourmanager.no/*"],
      "js": [
        "utils/debugUtils.js",
        "utils/findElementsUtils.js",
        "utils/cacheUtils.js",
        "utils/apiUtils.js",
        "utils/modificationUtils.js",
        "contentScript.js"
      ]
    }
  ]
}
